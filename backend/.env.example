# 后端环境变量示例。复制为 .env 后按需修改。
# 数据库连接串（PostgreSQL）
DATABASE_URL=postgres://huangding@localhost:5432/incident_handoff_gsb_0801_dev
# 测试数据库连接串（Vitest 使用）
TEST_DATABASE_URL=postgres://huangding@localhost:5432/incident_handoff_gsb_0801_test
# HTTP 监听端口
PORT=4000
# CORS 允许的前端来源
CORS_ORIGIN=http://localhost:5173
# 日志级别
LOG_LEVEL=info
